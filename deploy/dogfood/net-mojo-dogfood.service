[Unit]
Description=net-mojo dogfooding HTTP service
After=network.target

[Service]
Type=simple
User=net-mojo
Group=net-mojo
WorkingDirectory=/opt/net-mojo
ExecStart=/opt/net-mojo/build/http-dogfood
Environment=DOGFOOD_ADDRESS=127.0.0.1:8080
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true

[Install]
WantedBy=multi-user.target
