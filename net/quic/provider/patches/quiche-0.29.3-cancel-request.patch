+    /// Cancels both directions of an HTTP/3 request and releases its state.
+    ///
+    /// This can also be called for an incomplete field section, or after a
+    /// reset was reported by `poll()` or `recv_body()`. Already shut down or
+    /// collected request streams can be cancelled again. Control and QPACK
+    /// streams cannot be cancelled through this method.
+    pub fn cancel_request<F: BufFactory>(
+        &mut self, conn: &mut super::Connection<F>, stream_id: u64,
+        error_code: u64,
+    ) -> Result<()> {
+        if !stream_id.is_multiple_of(4) {
+            return Err(Error::FrameUnexpected);
+        }
+        if conn.streams.get(stream_id).is_none() &&
+            !conn.stream_closed(stream_id)
+        {
+            return Err(crate::Error::InvalidStreamState(stream_id).into());
+        }
+        for direction in [crate::Shutdown::Read, crate::Shutdown::Write] {
+            match conn.stream_shutdown(stream_id, direction, error_code) {
+                Ok(()) | Err(crate::Error::Done) => (),
+                Err(error) => return Err(error.into()),
+            }
+        }
+        self.streams.remove(&stream_id);
+        self.finished_streams.retain(|id| *id != stream_id);
+        Ok(())
+    }
