+#[cfg(test)]
+mod receive_view_compaction {
+    use super::*;
+
+    #[test]
+    fn ordinary_buffer_keeps_backing() {
+        let buf: RangeBuf = RangeBuf::from(b"abcdefgh", 20, true);
+        let pointer = buf.data.as_ref().as_ptr();
+        let compact = buf.compact_receive_view();
+        assert_eq!(compact.data.as_ref().as_ptr(), pointer);
+        assert_eq!(&compact[..], b"abcdefgh");
+        assert_eq!(
+            (compact.off(), compact.max_off(), compact.fin()),
+            (20, 28, true)
+        );
+    }
+
+    #[test]
+    fn current_view_keeps_bytes_offset_and_fin() {
+        let mut buf: RangeBuf = RangeBuf::from(b"abcdefgh", 20, true);
+        buf.consume(2);
+        let mut tail = buf.split_off(6);
+        tail.consume(1);
+        let compact = tail.compact_receive_view();
+        assert_eq!(&compact[..], b"h");
+        assert_eq!(compact.data.as_ref().len(), 1);
+        assert_eq!(
+            (compact.off(), compact.max_off(), compact.fin()),
+            (27, 28, true)
+        );
+    }
+
+    #[test]
+    fn empty_fin_keeps_final_offset() {
+        let mut buf: RangeBuf = RangeBuf::from(b"abc", 30, true);
+        buf.consume(3);
+        let compact = buf.compact_receive_view();
+        assert_eq!(compact.data.as_ref().len(), 0);
+        assert_eq!(
+            (compact.off(), compact.max_off(), compact.fin()),
+            (33, 33, true)
+        );
+    }
