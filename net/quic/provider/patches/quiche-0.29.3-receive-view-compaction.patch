+#[cfg(test)]
+mod receive_view_compaction {
+    use super::*;
+
+    fn receiver() -> RecvBuf {
+        RecvBuf::new(100, 100, 100)
+    }
+
+    fn assert_body(recv: &mut RecvBuf, expected: &[u8]) {
+        let mut body = vec![0; expected.len()];
+        assert_eq!(recv.emit(&mut body), Ok((expected.len(), true)));
+        assert_eq!(&body[..], expected);
+        assert!(recv.data.is_empty());
+    }
+
+    #[test]
+    fn prefix_overlap_preserves_tail_fin() {
+        let mut recv = receiver();
+        recv.write(RangeBuf::from(b"abcd", 0, false)).unwrap();
+        recv.write(RangeBuf::from(b"cdefgh", 2, true)).unwrap();
+        assert_eq!(recv.data.len(), 2);
+        assert_eq!(recv.max_off(), 8);
+        assert_body(&mut recv, b"abcdefgh");
+    }
+
+    #[test]
+    fn suffix_overlap_preserves_existing_end() {
+        let mut recv = receiver();
+        recv.write(RangeBuf::from(b"efgh", 4, false)).unwrap();
+        recv.write(RangeBuf::from(b"abcdef", 0, false)).unwrap();
+        recv.write(RangeBuf::from(b"", 8, true)).unwrap();
+        assert_eq!(recv.data.len(), 2);
+        assert_eq!(recv.max_off(), 8);
+        assert_body(&mut recv, b"abcdefgh");
+    }
+
+    #[test]
+    fn islands_keep_all_novel_ranges() {
+        let mut recv = receiver();
+        recv.write(RangeBuf::from(b"cd", 2, false)).unwrap();
+        recv.write(RangeBuf::from(b"gh", 6, false)).unwrap();
+        recv.write(RangeBuf::from(b"kl", 10, false)).unwrap();
+        recv.write(RangeBuf::from(b"abcdefghijklmn", 0, true)).unwrap();
+        assert_eq!(recv.data.len(), 7);
+        assert_eq!(recv.max_off(), 14);
+        assert_body(&mut recv, b"abcdefghijklmn");
+    }
+
+    #[test]
+    fn consumed_prefix_preserves_remaining_bytes() {
+        let mut recv = receiver();
+        recv.write(RangeBuf::from(b"abcdef", 0, false)).unwrap();
+        let mut prefix = [0; 4];
+        assert_eq!(recv.emit(&mut prefix), Ok((4, false)));
+        assert_eq!(&prefix, b"abcd");
+        let existing = recv.data.first_key_value().unwrap().1;
+        let pointer = &existing[0] as *const u8;
+        assert_eq!((existing.start, existing.pos, existing.len), (0, 4, 6));
+        recv.write(RangeBuf::from(b"cdefgh", 2, true)).unwrap();
+        let existing = recv.data.first_key_value().unwrap().1;
+        assert_eq!(&existing[0] as *const u8, pointer);
+        assert_eq!((existing.start, existing.pos, existing.len), (0, 4, 6));
+        assert_eq!(recv.data.len(), 2);
+        assert_body(&mut recv, b"efgh");
+    }
+
+    #[test]
+    fn trimmed_empty_fin_preserves_final_size() {
+        let mut recv = receiver();
+        let mut fin = RangeBuf::from(b"xyz", 3, true);
+        fin.consume(3);
+        recv.write(fin).unwrap();
+        assert_eq!(recv.max_off(), 6);
+        assert_eq!(recv.fin_off, Some(6));
+        assert_eq!(recv.data.len(), 1);
+        recv.write(RangeBuf::from(b"abcdef", 0, false)).unwrap();
+        assert_body(&mut recv, b"abcdef");
+    }
+}
