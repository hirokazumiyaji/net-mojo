+#[test]
+fn deferred_receive_credit_partial_consume_and_collected_fin() {
+    let mut pipe = test_utils::Pipe::new("reno").unwrap();
+    pipe.handshake().unwrap();
+    assert_eq!(pipe.client.stream_send(0, b"abcdefgh", true), Ok(8));
+    pipe.advance().unwrap();
+    let initial = pipe.server.flow_control.consumed();
+    assert_eq!(pipe.server.stream_recv_buf_deferred(0, &mut [0; 8][..]), Ok((8, true)));
+    assert_eq!(pipe.server.flow_control.consumed(), initial);
+    pipe.server.stream_consume(0, 3);
+    assert_eq!(pipe.server.flow_control.consumed(), initial + 3);
+    assert_eq!(pipe.server.stream_send(0, b"done", true), Ok(4));
+    pipe.advance().unwrap();
+    assert_eq!(pipe.client.stream_recv(0, &mut [0; 4]), Ok((4, true)));
+    assert!(pipe.server.streams.get(0).is_none());
+    pipe.server.stream_consume(0, 5);
+    assert_eq!(pipe.server.flow_control.consumed(), initial + 8);
+}
+
+#[test]
+fn deferred_receive_credit_shutdown_and_reset_leave_payload_debt_to_owner() {
+    for reset in [false, true] {
+        let mut pipe = test_utils::Pipe::new("reno").unwrap();
+        pipe.handshake().unwrap();
+        assert_eq!(pipe.client.stream_send(0, b"abcdefgh", false), Ok(8));
+        pipe.advance().unwrap();
+        let initial = pipe.server.flow_control.consumed();
+        assert_eq!(pipe.server.stream_recv_buf_deferred(0, &mut [0; 3][..]), Ok((3, false)));
+        if reset {
+            pipe.client.stream_shutdown(0, Shutdown::Write, 123).unwrap();
+            pipe.advance().unwrap();
+        } else {
+            pipe.server.stream_shutdown(0, Shutdown::Read, 123).unwrap();
+        }
+        assert_eq!(pipe.server.flow_control.consumed(), initial + 5);
+        pipe.server.stream_consume(0, 3);
+        assert_eq!(pipe.server.flow_control.consumed(), initial + 8);
+    }
 }
