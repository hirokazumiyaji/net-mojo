+    /// Returns true if the collection contains the given value.
+    pub fn contains(&self, item: u64) -> bool {
+        match self {
+            RangeSet::Inline(set) => set
+                .inner
+                .iter()
+                .any(|&(start, end)| start <= item && item < end),
+
+            RangeSet::BTree(set) =>
+                set.prev_to(item).is_some_and(|range| item < range.end),
+        }
+    }
