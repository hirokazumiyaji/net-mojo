+#[rstest]
+fn locally_drained_fix_preserves_application_delivery(
+    #[values(false, true)] reset: bool,
+) {
+    let mut pipe = test_utils::Pipe::new("cubic").unwrap();
+    pipe.handshake().unwrap();
+    assert_eq!(pipe.client.stream_send(2, b"hello", !reset), Ok(5));
+    pipe.advance().unwrap();
+    if reset {
+        pipe.client.stream_shutdown(2, Shutdown::Write, 10).unwrap();
+        pipe.advance().unwrap();
+    }
+    assert!(pipe.server.streams.get(2).is_some());
+    assert!(!pipe.server.streams.is_collected(2));
+    assert!(pipe.server.readable().any(|id| id == 2));
+    let mut body = [0; 32];
+    if reset {
+        assert_eq!(
+            pipe.server.stream_recv(2, &mut body),
+            Err(Error::StreamReset(10))
+        );
+    } else {
+        assert_eq!(pipe.server.stream_recv(2, &mut body), Ok((5, true)));
+        assert_eq!(&body[..5], b"hello");
+    }
+    assert!(pipe.server.streams.is_collected(2));
+}
