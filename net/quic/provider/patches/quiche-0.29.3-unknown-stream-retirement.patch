+#[rstest]
+fn locally_drained_stream_returns_credit(
+    #[values(0, 1, 2, 3)] order: u8,
+    #[values(false, true)] bidi: bool,
+) {
+    let mut config = test_utils::Pipe::default_config("cubic").unwrap();
+    config.set_initial_max_data(100);
+    config.set_initial_max_streams_uni(1);
+    config.set_initial_max_streams_bidi(1);
+    let mut pipe = test_utils::Pipe::with_config(&mut config).unwrap();
+    pipe.handshake().unwrap();
+    let id = if bidi { 0 } else { 2 };
+    assert_eq!(pipe.client.stream_send(id, b"hello", order == 0), Ok(5));
+    pipe.advance().unwrap();
+
+    let mut packet = [0; 65535];
+    if order == 1 || order == 3 {
+        assert_eq!(pipe.client.stream_send(id, b"world", false), Ok(5));
+        // Lost in-flight data must still count toward RESET_STREAM final size.
+        assert!(pipe.client.send(&mut packet).is_ok());
+        if order == 1 {
+            pipe.client
+                .stream_shutdown(id, Shutdown::Write, 10)
+                .unwrap();
+            pipe.advance().unwrap();
+        }
+    }
+    pipe.server.stream_shutdown(id, Shutdown::Read, 0).unwrap();
+    if order == 2 {
+        assert_eq!(pipe.client.stream_send(id, b"world", true), Ok(5));
+        pipe.advance().unwrap();
+    } else if order == 3 {
+        pipe.client
+            .stream_shutdown(id, Shutdown::Write, 10)
+            .unwrap();
+        pipe.advance().unwrap();
+    }
+
+    let expected = if order == 0 { 5 } else { 10 };
+    assert_eq!(pipe.server.rx_data, expected);
+    assert_eq!(
+        pipe.server.flow_control.max_data_next()
+            - pipe.server.flow_control.window(),
+        expected
+    );
+    assert!(!pipe.server.readable().any(|stream_id| stream_id == id));
+    if bidi {
+        assert!(pipe.server.streams.get(id).is_some());
+        assert!(!pipe.server.streams.is_collected(id));
+        assert_eq!(pipe.server.streams.max_streams_bidi_next(), 1);
+        assert_eq!(pipe.server.stream_send(id, b"response", true), Ok(8));
+        pipe.advance().unwrap();
+        assert_eq!(pipe.client.stream_recv(id, &mut packet), Ok((8, true)));
+        assert_eq!(&packet[..8], b"response");
+        pipe.advance().unwrap();
+    }
+    assert!(pipe.server.streams.get(id).is_none());
+    assert!(pipe.server.streams.is_collected(id));
+    assert_eq!(
+        pipe.server.streams.max_streams_uni_next(),
+        if bidi { 1 } else { 2 }
+    );
+    assert_eq!(
+        pipe.server.streams.max_streams_bidi_next(),
+        if bidi { 2 } else { 1 }
+    );
+    pipe.advance().unwrap();
+    assert_eq!(pipe.client.peer_streams_left_uni(), 1);
+    assert_eq!(pipe.client.peer_streams_left_bidi(), 1);
+}
