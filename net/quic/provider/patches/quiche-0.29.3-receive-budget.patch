+// Copyright (C) 2026, net-mojo contributors.
+// SPDX-License-Identifier: BSD-2-Clause
+
+use std::sync::{Arc, Mutex};
+
+use crate::{Error, Result};
+
+/// Independent retained payload and object population limits.
+#[derive(Clone, Copy, Debug, Default, PartialEq, Eq)]
+pub struct ReceiveLimit {
+    /// Retained payload bytes, conservatively counted per view.
+    pub backing_bytes: usize,
+    /// Buffer/fragment tokens, not an allocator-byte estimate.
+    pub slots: usize,
+}
+
+/// Separate receive resources for bidirectional, unidirectional and CRYPTO data.
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub struct ReceiveLimits {
+    /// Bidirectional receive resources, including responses on clients.
+    pub request: ReceiveLimit,
+    /// Unidirectional receive resources.
+    pub control: ReceiveLimit,
+    /// CRYPTO receive resources across all packet epochs.
+    pub crypto: ReceiveLimit,
+}
+
+impl Default for ReceiveLimits {
+    fn default() -> Self {
+        let unlimited = ReceiveLimit {
+            backing_bytes: usize::MAX,
+            slots: usize::MAX,
+        };
+        Self {
+            request: unlimited,
+            control: unlimited,
+            crypto: unlimited,
+        }
+    }
+}
+
+/// Conservative charges currently reserved, including in-progress admissions.
+#[derive(Clone, Copy, Debug, Default, PartialEq, Eq)]
+pub struct ReceiveUsage {
+    /// Bidirectional receive resources, including responses on clients.
+    pub request: ReceiveLimit,
+    /// Unidirectional receive resources.
+    pub control: ReceiveLimit,
+    /// CRYPTO receive resources across all packet epochs.
+    pub crypto: ReceiveLimit,
+}
+
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub(crate) enum ReceiveClass {
+    Request,
+    Control,
+    Crypto,
+}
+
+impl ReceiveClass {
+    fn error(self) -> Error {
+        match self {
+            Self::Crypto => Error::CryptoBufferExceeded,
+            Self::Request | Self::Control => Error::ReceiveBufferExceeded,
+        }
+    }
+    fn limit(self, limits: &ReceiveLimits) -> ReceiveLimit {
+        match self {
+            Self::Request => limits.request,
+            Self::Control => limits.control,
+            Self::Crypto => limits.crypto,
+        }
+    }
+    fn used(self, usage: &mut ReceiveUsage) -> &mut ReceiveLimit {
+        match self {
+            Self::Request => &mut usage.request,
+            Self::Control => &mut usage.control,
+            Self::Crypto => &mut usage.crypto,
+        }
+    }
+}
+
+#[derive(Debug)]
+struct Shared {
+    limits: ReceiveLimits,
+    used: Mutex<ReceiveUsage>,
+}
+
+/// Immutable capacities shared by all configurations/connections using a clone.
+#[derive(Clone, Debug)]
+pub struct ReceiveBudget(Arc<Shared>);
+
+impl Default for ReceiveBudget {
+    fn default() -> Self {
+        Self::new(ReceiveLimits::default())
+    }
+}
+
+impl ReceiveBudget {
+    /// Creates a shared budget whose capacities cannot be changed.
+    pub fn new(limits: ReceiveLimits) -> Self {
+        Self(Arc::new(Shared {
+            limits,
+            used: Mutex::new(ReceiveUsage::default()),
+        }))
+    }
+    /// Returns a consistent snapshot of all three resource classes.
+    pub fn usage(&self) -> ReceiveUsage {
+        *self.0.used.lock().unwrap()
+    }
+
+    fn reserve(&self, class: ReceiveClass, amount: ReceiveLimit) -> Result<Reservation> {
+        let mut usage = self.0.used.lock().unwrap();
+        let used = class.used(&mut usage);
+        let limit = class.limit(&self.0.limits);
+        let backing_bytes = used
+            .backing_bytes
+            .checked_add(amount.backing_bytes)
+            .ok_or_else(|| class.error())?;
+        let slots = used
+            .slots
+            .checked_add(amount.slots)
+            .ok_or_else(|| class.error())?;
+        if backing_bytes > limit.backing_bytes || slots > limit.slots {
+            return Err(class.error());
+        }
+        *used = ReceiveLimit {
+            backing_bytes,
+            slots,
+        };
+        Ok(Reservation {
+            budget: self.clone(),
+            class,
+            amount,
+        })
+    }
+
+    fn release(&self, class: ReceiveClass, amount: ReceiveLimit) {
+        let mut usage = self.0.used.lock().unwrap();
+        let used = class.used(&mut usage);
+        used.backing_bytes -= amount.backing_bytes;
+        used.slots -= amount.slots;
+    }
+}
+
+pub(crate) struct Reservation {
+    budget: ReceiveBudget,
+    class: ReceiveClass,
+    amount: ReceiveLimit,
+}
+
+impl Reservation {
+    pub(crate) fn commit_entry(&mut self, owner: &mut BufferCharge, backing_bytes: usize) {
+        self.amount.backing_bytes -= backing_bytes;
+        self.amount.slots -= 1;
+        owner.used.backing_bytes += backing_bytes;
+        owner.used.slots += 1;
+    }
+    pub(crate) fn commit(mut self, owner: &mut BufferCharge) {
+        owner.used.backing_bytes += self.amount.backing_bytes;
+        owner.used.slots += self.amount.slots;
+        self.amount = ReceiveLimit::default();
+    }
+}
+
+impl Drop for Reservation {
+    fn drop(&mut self) {
+        self.budget.release(self.class, self.amount);
+    }
+}
+
+#[derive(Debug)]
+pub(crate) struct BufferCharge {
+    budget: ReceiveBudget,
+    class: ReceiveClass,
+    used: ReceiveLimit,
+}
+
+impl BufferCharge {
+    pub(crate) fn new(budget: ReceiveBudget, class: ReceiveClass) -> Result<Self> {
+        // Prepaid terminal metadata keeps RESET delivery possible at full payload quota.
+        let reservation = budget.reserve(
+            class,
+            ReceiveLimit {
+                backing_bytes: 0,
+                slots: 2,
+            },
+        )?;
+        let mut owner = Self {
+            budget,
+            class,
+            used: ReceiveLimit::default(),
+        };
+        reservation.commit(&mut owner);
+        Ok(owner)
+    }
+    pub(crate) fn reserve(&self, amount: ReceiveLimit) -> Result<Reservation> {
+        self.budget.reserve(self.class, amount)
+    }
+    pub(crate) fn release_entry(&mut self, backing_bytes: usize) {
+        let amount = ReceiveLimit {
+            backing_bytes,
+            slots: 1,
+        };
+        self.budget.release(self.class, amount);
+        self.used.backing_bytes -= backing_bytes;
+        self.used.slots -= 1;
+    }
+    pub(crate) fn clear_retained(&mut self) {
+        let amount = ReceiveLimit {
+            backing_bytes: self.used.backing_bytes,
+            slots: self.used.slots - 2,
+        };
+        self.budget.release(self.class, amount);
+        self.used.backing_bytes = 0;
+        self.used.slots = 2;
+    }
+}
+
+impl Drop for BufferCharge {
+    fn drop(&mut self) {
+        self.budget.release(self.class, self.used);
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    #[test]
+    fn receive_budget_reservation_rollback_and_checked_addition() {
+        let budget = ReceiveBudget::default();
+        let mut owner = BufferCharge::new(budget.clone(), ReceiveClass::Request).unwrap();
+        let reservation = owner
+            .reserve(ReceiveLimit {
+                backing_bytes: usize::MAX,
+                slots: usize::MAX - 2,
+            })
+            .unwrap();
+        assert!(matches!(
+            owner.reserve(ReceiveLimit {
+                backing_bytes: 1,
+                slots: 0
+            }),
+            Err(Error::ReceiveBufferExceeded)
+        ));
+        assert!(matches!(
+            owner.reserve(ReceiveLimit {
+                backing_bytes: 0,
+                slots: 1
+            }),
+            Err(Error::ReceiveBufferExceeded)
+        ));
+        drop(reservation);
+        assert_eq!(
+            budget.usage().request,
+            ReceiveLimit {
+                backing_bytes: 0,
+                slots: 2
+            }
+        );
+        owner
+            .reserve(ReceiveLimit {
+                backing_bytes: 7,
+                slots: 1,
+            })
+            .unwrap()
+            .commit(&mut owner);
+        assert_eq!(
+            budget.usage().request,
+            ReceiveLimit {
+                backing_bytes: 7,
+                slots: 3
+            }
+        );
+        drop(owner);
+        assert_eq!(budget.usage(), ReceiveUsage::default());
+    }
+}
