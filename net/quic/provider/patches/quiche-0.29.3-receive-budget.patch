+    }
+
+    fn limits() -> ReceiveLimits {
+        ReceiveLimits {
+            request: ReceiveLimit {
+                backing_bytes: 64,
+                slots: 6,
+            },
+            control: ReceiveLimit {
+                backing_bytes: 4096,
+                slots: 32,
+            },
+            crypto: ReceiveLimit {
+                backing_bytes: 4096,
+                slots: 64,
+            },
+        }
+    }
+
+    fn config() -> Config {
+        let mut config = test_utils::Pipe::default_config("reno").unwrap();
+        config
+            .set_application_protos(h3::APPLICATION_PROTOCOL)
+            .unwrap();
+        config.set_initial_max_data(10_000_000);
+        config.set_initial_max_stream_data_bidi_local(1_000_000);
+        config.set_initial_max_stream_data_bidi_remote(1_000_000);
+        config.set_initial_max_stream_data_uni(1_000_000);
+        config.set_initial_max_streams_bidi(100);
+        config.set_initial_max_streams_uni(3);
+        config
+    }
+
+    fn pair(budget: &ReceiveBudget) -> Pair {
+        let mut server_config = config();
+        server_config.set_receive_budget(budget.clone());
+        let mut pipe = test_utils::Pipe::with_client_and_server_config(
+            &mut config(),
+            &mut server_config,
+        )
+        .unwrap();
+        pipe.handshake().unwrap();
+        pipe.advance().unwrap();
+        let mut config = h3::Config::new().unwrap();
+        config.set_qpack_max_table_capacity(0);
+        config.set_qpack_blocked_streams(0);
+        let mut client =
+            h3::Connection::with_transport(&mut pipe.client, &config).unwrap();
+        let mut server =
+            h3::Connection::with_transport(&mut pipe.server, &config).unwrap();
+        let headers = [
+            h3::Header::new(b":method", b"POST"),
+            h3::Header::new(b":scheme", b"https"),
+            h3::Header::new(b":authority", b"quic.tech"),
+            h3::Header::new(b":path", b"/"),
+            h3::Header::new(b"content-length", b"128"),
+        ];
+        assert_eq!(
+            client.send_request(&mut pipe.client, &headers, false),
+            Ok(0)
+        );
+        // The held gap belongs to DATA, after valid HTTP framing was consumed.
+        pipe.client.stream_send(0, &[0, 0x40, 0x80], false).unwrap();
+        pipe.advance().unwrap();
+        let mut headers_seen = false;
+        loop {
+            match server.poll(&mut pipe.server) {
+                Ok((0, h3::Event::Headers { .. })) => {
+                    headers_seen = true;
+                },
+                Ok((0, h3::Event::Data)) => (),
+                Err(h3::Error::Done) => break,
+                event => panic!("unexpected initial H3 event {event:?}"),
+            }
+        }
+        assert!(headers_seen);
+        assert!(server.peer_settings_raw().is_some());
+        let base = pipe.server.streams.get(0).unwrap().recv.max_off();
+        assert_eq!(pipe.server.stream_recv(0, &mut [0; 1]), Err(Error::Done));
+        Pair {
+            pipe,
+            client,
+            server,
+            base,
+        }
+    }
+
+    fn inject(pair: &mut Pair, frame: frame::Frame) -> Result<usize> {
+        let mut packet = [0; 2048];
+        let written = test_utils::encode_pkt(
+            &mut pair.pipe.client,
+            Type::Short,
+            &[frame],
+            &mut packet,
+        )
+        .unwrap();
+        // Synthetic receive frames have no sender recovery records to ACK.
+        pair.pipe.server_recv(&mut packet[..written])
+    }
+
+    fn fill(pair: &mut Pair) {
+        let base = pair.base;
+        inject(
+            pair,
+            frame::Frame::Stream {
+                stream_id: 0,
+                data: RangeBuf::from(&[b'b'; 64], base + 1, false),
+            },
+        )
+        .unwrap();
+    }
+
+    #[test]
+    fn receive_budget_two_authenticated_connections_share_reject_and_refund() {
+        let budget = ReceiveBudget::new(limits());
+        let mut first = pair(&budget);
+        let mut second = pair(&budget);
+        fill(&mut first);
+        assert_eq!(
+            budget.usage().request,
+            ReceiveLimit {
+                backing_bytes: 64,
+                slots: 5
+            }
+        );
+        let state = second
+            .pipe
+            .server
+            .streams
+            .get(0)
+            .unwrap()
+            .recv
+            .test_receive_budget_state();
+        let received = second.pipe.server.rx_data;
+        let usage = budget.usage();
+        let base = second.base;
+        assert_eq!(
+            inject(
+                &mut second,
+                frame::Frame::Stream {
+                    stream_id: 0,
+                    data: RangeBuf::from(b"b", base + 127, true)
+                }
+            ),
+            Err(Error::ReceiveBufferExceeded)
+        );
+        assert_eq!(
+            second
+                .pipe
+                .server
+                .streams
+                .get(0)
+                .unwrap()
+                .recv
+                .test_receive_budget_state(),
+            state
+        );
+        assert_eq!(second.pipe.server.rx_data, received);
+        assert_eq!(budget.usage(), usage);
+        let closed = second.pipe.server.local_error().unwrap();
+        assert!(!closed.is_app);
+        assert_eq!(closed.error_code, 0x1);
+        drop(second);
+        assert_eq!(
+            budget.usage().request,
+            ReceiveLimit {
+                backing_bytes: 64,
+                slots: 3
+            }
+        );
+        drop(first);
+        assert_eq!(budget.usage(), ReceiveUsage::default());
+
+        let budget = ReceiveBudget::new(limits());
+        let mut first = pair(&budget);
+        let mut second = pair(&budget);
+        fill(&mut first);
+        drop(first);
+        assert_eq!(
+            budget.usage().request,
+            ReceiveLimit {
+                backing_bytes: 0,
+                slots: 2
+            }
+        );
+        let base = second.base;
+        inject(
+            &mut second,
+            frame::Frame::Stream {
+                stream_id: 0,
+                data: RangeBuf::from(b"b", base + 127, true),
+            },
+        )
+        .unwrap();
+        assert_eq!(
+            budget.usage().request,
+            ReceiveLimit {
+                backing_bytes: 1,
+                slots: 3
+            }
+        );
+        drop(second);
+        assert_eq!(budget.usage(), ReceiveUsage::default());
+    }
+
+    #[test]
+    fn receive_budget_request_full_keeps_valid_control_and_reset_resources() {
+        let budget = ReceiveBudget::new(limits());
+        let mut pair = pair(&budget);
+        fill(&mut pair);
+        let full = budget.usage().request;
+        assert_eq!(full.backing_bytes, 64);
+        let before = pair.pipe.server.streams.get(2).unwrap().recv.off_front();
+        pair.client
+            .send_priority_update_for_request(
+                &mut pair.pipe.client,
+                0,
+                &h3::Priority::new(0, false),
+            )
+            .unwrap();
+        let flight = test_utils::emit_flight(&mut pair.pipe.client).unwrap();
+        test_utils::process_flight(&mut pair.pipe.server, flight).unwrap();
+        assert_eq!(
+            pair.server.poll(&mut pair.pipe.server),
+            Ok((0, h3::Event::PriorityUpdate))
+        );
+        assert_eq!(
+            pair.server.take_last_priority_update(0),
+            Ok(b"u=0".to_vec())
+        );
+        assert!(
+            pair.pipe.server.streams.get(2).unwrap().recv.off_front() > before
+        );
+        assert_eq!(budget.usage().request, full);
+        let base = pair.base;
+        inject(
+            &mut pair,
+            frame::Frame::ResetStream {
+                stream_id: 0,
+                error_code: 0x10c,
+                final_size: base + 128,
+            },
+        )
+        .unwrap();
+        assert_eq!(
+            pair.server.poll(&mut pair.pipe.server),
+            Ok((0, h3::Event::Reset(0x10c)))
+        );
+        pair.server
+            .cancel_request(&mut pair.pipe.server, 0, 0x10c)
+            .unwrap();
+        assert!(pair.pipe.server.streams.get(0).is_some());
+        assert_eq!(
+            budget.usage().request,
+            ReceiveLimit {
+                backing_bytes: 0,
+                slots: 2
+            }
+        );
+        drop(pair);
+        assert_eq!(budget.usage(), ReceiveUsage::default());
+    }
+
+    #[test]
+    fn receive_budget_authenticated_crypto_exhaustion_is_separate() {
+        let budget = ReceiveBudget::new(limits());
+        let mut pair = pair(&budget);
+        fill(&mut pair);
+        let request = budget.usage().request;
+        let base = pair.pipe.server.crypto_ctx[packet::Epoch::Application]
+            .crypto_stream
+            .recv
+            .max_off();
+        let available = limits().crypto.slots - budget.usage().crypto.slots;
+        for off in 1..=available as u64 {
+            inject(
+                &mut pair,
+                frame::Frame::Crypto {
+                    data: RangeBuf::from(b"b", base + off, false),
+                },
+            )
+            .unwrap();
+        }
+        let usage = budget.usage();
+        assert_eq!(usage.crypto.slots, limits().crypto.slots);
+        assert_eq!(usage.request, request);
+        let before = pair.pipe.server.crypto_ctx[packet::Epoch::Application]
+            .crypto_stream
+            .recv
+            .test_receive_budget_state();
+        assert_eq!(
+            inject(
+                &mut pair,
+                frame::Frame::Crypto {
+                    data: RangeBuf::from(
+                        b"b",
+                        base + available as u64 + 1,
+                        false
+                    )
+                }
+            ),
+            Err(Error::CryptoBufferExceeded)
+        );
+        assert_eq!(
+            pair.pipe.server.crypto_ctx[packet::Epoch::Application]
+                .crypto_stream
+                .recv
+                .test_receive_budget_state(),
+            before
+        );
+        assert_eq!(budget.usage(), usage);
+        assert_eq!(pair.pipe.server.local_error().unwrap().error_code, 0xd);
+        drop(pair);
+        assert_eq!(budget.usage(), ReceiveUsage::default());
+    }
+
