+#[cfg(test)]
+mod receive_budget_tests {
+    use super::*;
+    use crate::{ReceiveLimits, ReceiveUsage};
+
+    fn limited(backing_bytes: usize, slots: usize) -> ReceiveBudget {
+        ReceiveBudget::new(ReceiveLimits {
+            request: ReceiveLimit {
+                backing_bytes,
+                slots,
+            },
+            ..ReceiveLimits::default()
+        })
+    }
+    fn receiver(budget: &ReceiveBudget) -> RecvBuf {
+        RecvBuf::new(100, 100, 100, budget.clone(), ReceiveClass::Request)
+            .unwrap()
+    }
+    fn islands(recv: &mut RecvBuf) {
+        for (off, bytes) in [(2, b"cd"), (6, b"gh"), (10, b"kl")] {
+            recv.write(RangeBuf::from(bytes, off, false)).unwrap();
+        }
+    }
+
+    #[test]
+    fn receive_budget_atomic_islands_backing_and_fin_rejection() {
+        for (bytes, slots) in [(14, 8), (7, 9)] {
+            let budget = limited(bytes, slots);
+            let mut recv = receiver(&budget);
+            islands(&mut recv);
+            let before = recv.test_receive_budget_state();
+            let usage = budget.usage();
+            assert_eq!(
+                usage.request,
+                ReceiveLimit {
+                    backing_bytes: 6,
+                    slots: 5
+                }
+            );
+            assert_eq!(
+                recv.write(RangeBuf::from(b"abcdefghijklmn", 0, true)),
+                Err(Error::ReceiveBufferExceeded)
+            );
+            assert_eq!(recv.test_receive_budget_state(), before);
+            assert_eq!(budget.usage(), usage);
+            drop(recv);
+            assert_eq!(budget.usage(), ReceiveUsage::default());
+        }
+    }
+
+    #[test]
+    fn receive_budget_duplicate_and_covered_fin_at_full_quota() {
+        let budget = limited(6, 5);
+        let mut recv = receiver(&budget);
+        islands(&mut recv);
+        let before = budget.usage();
+        recv.write(RangeBuf::from(b"kl", 10, false)).unwrap();
+        recv.write(RangeBuf::from(b"", 12, true)).unwrap();
+        recv.write(RangeBuf::from(b"kl", 10, true)).unwrap();
+        recv.write(RangeBuf::from(b"", 12, true)).unwrap();
+        assert_eq!(budget.usage(), before);
+        assert_eq!(recv.data.len(), 3);
+        assert_eq!(recv.fin_off, Some(12));
+        assert_eq!(
+            recv.write(RangeBuf::from(b"", 11, true)),
+            Err(Error::FinalSize)
+        );
+        assert_eq!(budget.usage(), before);
+    }
+
+    #[test]
+    fn receive_budget_partial_backing_full_read_and_consumed_duplicate() {
+        let budget = limited(8, 3);
+        let mut recv = receiver(&budget);
+        recv.write(RangeBuf::from(b"abcdefgh", 0, true)).unwrap();
+        let mut first = [0; 7];
+        assert_eq!(recv.emit(&mut first), Ok((7, false)));
+        assert_eq!(&first, b"abcdefg");
+        assert_eq!(
+            recv.data.first_key_value().unwrap().1.receive_backing_len(),
+            8
+        );
+        assert_eq!(
+            budget.usage().request,
+            ReceiveLimit {
+                backing_bytes: 8,
+                slots: 3
+            }
+        );
+        recv.write(RangeBuf::from(b"abcdefgh", 0, false)).unwrap();
+        assert_eq!(
+            budget.usage().request,
+            ReceiveLimit {
+                backing_bytes: 8,
+                slots: 3
+            }
+        );
+        let mut last = [0; 1];
+        assert_eq!(recv.emit(&mut last), Ok((1, true)));
+        assert_eq!(&last, b"h");
+        assert_eq!(
+            budget.usage().request,
+            ReceiveLimit {
+                backing_bytes: 0,
+                slots: 2
+            }
+        );
+        drop(recv);
+        assert_eq!(budget.usage(), ReceiveUsage::default());
+    }
+
+    #[test]
+    fn receive_budget_discard_keeps_partial_backing_until_entry_release() {
+        let budget = limited(4, 3);
+        let mut recv = receiver(&budget);
+        recv.write(RangeBuf::from(b"abcd", 0, true)).unwrap();
+        assert_eq!(
+            recv.emit_or_discard::<&mut [u8]>(RecvAction::Discard { len: 3 }),
+            Ok((3, false))
+        );
+        assert_eq!(
+            budget.usage().request,
+            ReceiveLimit {
+                backing_bytes: 4,
+                slots: 3
+            }
+        );
+        assert_eq!(
+            recv.emit_or_discard::<&mut [u8]>(RecvAction::Discard { len: 1 }),
+            Ok((1, true))
+        );
+        assert_eq!(
+            budget.usage().request,
+            ReceiveLimit {
+                backing_bytes: 0,
+                slots: 2
+            }
+        );
+        drop(recv);
+        assert_eq!(budget.usage(), ReceiveUsage::default());
+    }
+
+    #[test]
+    fn receive_budget_consumed_input_split_around_island() {
+        let budget = limited(5, 5);
+        let mut recv = receiver(&budget);
+        recv.write(RangeBuf::from(b"abc", 0, false)).unwrap();
+        assert_eq!(recv.emit(&mut [0; 3]), Ok((3, false)));
+        recv.write(RangeBuf::from(b"e", 4, false)).unwrap();
+        let mut range = RangeBuf::from(b"abcdefgh", 0, true);
+        range.consume(3);
+        recv.write(range).unwrap();
+        let intervals: Vec<_> = recv
+            .data
+            .values()
+            .map(|b| {
+                (
+                    b.off(),
+                    b.max_off(),
+                    b.fin(),
+                    b.to_vec(),
+                    b.receive_backing_len(),
+                )
+            })
+            .collect();
+        assert_eq!(
+            intervals,
+            vec![
+                (3, 4, false, b"d".to_vec(), 1),
+                (4, 5, false, b"e".to_vec(), 1),
+                (5, 8, true, b"fgh".to_vec(), 3),
+            ]
+        );
+        assert_eq!(recv.fin_off, Some(8));
+        assert_eq!(
+            budget.usage().request,
+            ReceiveLimit {
+                backing_bytes: 5,
+                slots: 5
+            }
+        );
+        let mut out = [0; 5];
+        assert_eq!(recv.emit(&mut out), Ok((5, true)));
+        assert_eq!(&out, b"defgh");
+        assert_eq!(
+            budget.usage().request,
+            ReceiveLimit {
+                backing_bytes: 0,
+                slots: 2
+            }
+        );
+        drop(recv);
+        assert_eq!(budget.usage(), ReceiveUsage::default());
+    }
+
+    #[test]
+    fn receive_budget_trimmed_input_and_shutdown_charge_actual_backing() {
+        let budget = limited(1, 3);
+        let mut recv = receiver(&budget);
+        let mut range = RangeBuf::from(b"abcdefgh", 0, true);
+        range.consume(7);
+        assert_eq!(range.receive_backing_len(), 8);
+        recv.write(range).unwrap();
+        assert_eq!(
+            recv.data.first_key_value().unwrap().1.receive_backing_len(),
+            1
+        );
+        assert_eq!(
+            budget.usage().request,
+            ReceiveLimit {
+                backing_bytes: 1,
+                slots: 3
+            }
+        );
+        assert_eq!(recv.shutdown(), Ok(8));
+        assert_eq!(
+            budget.usage().request,
+            ReceiveLimit {
+                backing_bytes: 0,
+                slots: 2
+            }
+        );
+        recv.write(RangeBuf::from(b"abcdefgh", 0, false)).unwrap();
+        assert_eq!(
+            budget.usage().request,
+            ReceiveLimit {
+                backing_bytes: 0,
+                slots: 2
+            }
+        );
+        drop(recv);
+        assert_eq!(budget.usage(), ReceiveUsage::default());
+    }
+
+    #[test]
+    fn receive_budget_empty_marker_replacement_and_error_delivery() {
+        let budget = limited(4, 3);
+        let mut recv = receiver(&budget);
+        recv.write(RangeBuf::from(b"", 4, true)).unwrap();
+        assert_eq!(
+            budget.usage().request,
+            ReceiveLimit {
+                backing_bytes: 0,
+                slots: 2
+            }
+        );
+        recv.write(RangeBuf::from(b"abcd", 0, false)).unwrap();
+        assert_eq!(
+            budget.usage().request,
+            ReceiveLimit {
+                backing_bytes: 4,
+                slots: 3
+            }
+        );
+        assert_eq!(recv.data.len(), 1);
+        assert_eq!(recv.emit(&mut [0; 4]), Ok((4, true)));
+        drop(recv);
+        assert_eq!(budget.usage(), ReceiveUsage::default());
+
+        let budget = limited(2, 5);
+        let mut first = receiver(&budget);
+        let mut second = receiver(&budget);
+        first.write(RangeBuf::from(b"cd", 2, false)).unwrap();
+        first.reset(0x10c, 4).unwrap();
+        second.write(RangeBuf::from(b"xy", 0, false)).unwrap();
+        let full = budget.usage();
+        assert_eq!(
+            full.request,
+            ReceiveLimit {
+                backing_bytes: 2,
+                slots: 5
+            }
+        );
+        assert_eq!(first.emit(&mut [0; 1]), Err(Error::StreamReset(0x10c)));
+        assert_eq!(budget.usage(), full);
+        drop(first);
+        drop(second);
+        assert_eq!(budget.usage(), ReceiveUsage::default());
+    }
