+    #[test]
+    fn receive_budget_crypto_clear_preserves_base_ownership() {
+        let budget = ReceiveBudget::new(ReceiveLimits {
+            crypto: ReceiveLimit {
+                backing_bytes: 8,
+                slots: 3,
+            },
+            ..ReceiveLimits::default()
