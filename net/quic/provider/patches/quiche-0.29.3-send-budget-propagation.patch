+use super::*;
+use crate::{SendBudget, SendLimit, SendLimits, SendUsage};
+
+fn control_pool(bytes: usize, slots: usize) -> SendBudget {
+    SendBudget::new(SendLimits {
+        control: SendLimit { backing_bytes: bytes, slots },
+        ..SendLimits::default()
+    })
+}
+
+fn control_pipe(budget: &SendBudget, grease: bool, credit: u64, uni: u64)
+    -> crate::test_utils::Pipe
+{
+    let mut client = crate::test_utils::Pipe::default_config("reno").unwrap();
+    client.set_application_protos(APPLICATION_PROTOCOL).unwrap();
+    client.set_initial_max_data(credit);
+    client.set_initial_max_stream_data_uni(4096);
+    client.set_initial_max_streams_uni(uni);
+    client.grease(false);
+    let mut server = crate::test_utils::Pipe::default_config("reno").unwrap();
+    server.set_application_protos(APPLICATION_PROTOCOL).unwrap();
+    server.grease(grease);
+    server.set_send_budget(budget.clone());
+    let mut pipe = crate::test_utils::Pipe::with_client_and_server_config(
+        &mut client, &mut server,
+    ).unwrap();
+    pipe.handshake().unwrap();
+    pipe.advance().unwrap();
+    pipe
+}
+
+fn assert_optional_quota(slots: usize, grease: bool, successful_qpack: usize) {
+    let budget = control_pool(1024, slots);
+    let mut pipe = control_pipe(&budget, grease, 65536, 8);
+    let result = Connection::with_transport(&mut pipe.server, &Config::new().unwrap());
+    assert!(pipe.server.local_error().is_none());
+    for id in [7, 11].into_iter().take(successful_qpack) {
+        assert_eq!(pipe.server.streams.get_mut(id).unwrap().send.buffered_bytes(), 1);
+    }
+    assert!(matches!(result, Err(Error::TransportError(crate::Error::SendBufferExceeded))));
+    drop(result);
+    drop(pipe);
+    assert_eq!(budget.usage(), SendUsage::default());
+}
+
+#[test]
+fn send_propagation_h3_settings_quota_preserves_transport_cause_without_app_close() {
+    let budget = control_pool(0, 64);
+    let mut pipe = control_pipe(&budget, false, 65536, 8);
+    let result = Connection::with_transport(&mut pipe.server, &Config::new().unwrap());
+    assert!(matches!(result, Err(Error::TransportError(crate::Error::SendBufferExceeded))));
+    assert!(pipe.server.local_error().is_none());
+    drop(result);
+    drop(pipe);
+    assert_eq!(budget.usage(), SendUsage::default());
+}
+
+#[test]
+fn send_propagation_h3_optional_encoder_quota_is_not_ignored() {
+    assert_optional_quota(6, false, 0);
+}
+
+#[test]
+fn send_propagation_h3_optional_decoder_quota_is_not_ignored() {
+    assert_optional_quota(12, false, 1);
+}
+
+#[test]
+fn send_propagation_h3_optional_grease_quota_is_not_ignored() {
+    assert_optional_quota(22, true, 2);
+}
+
+#[test]
+fn send_propagation_h3_optional_done_is_still_ignored() {
+    let budget = control_pool(1024, 128);
+    let mut pipe = control_pipe(&budget, false, 3, 8);
+    let h3 = Connection::with_transport(&mut pipe.server, &Config::new().unwrap()).unwrap();
+    assert!(h3.control_stream_id.is_some());
+    assert!(h3.local_qpack_streams.encoder_stream_id.is_none());
+    assert!(h3.local_qpack_streams.decoder_stream_id.is_none());
+    assert_eq!(budget.usage().control.backing_bytes, 3);
+    assert!(pipe.server.local_error().is_none());
+    drop(h3);
+    drop(pipe);
+    assert_eq!(budget.usage(), SendUsage::default());
+}
+
+#[test]
+fn send_propagation_h3_optional_stream_limit_is_still_ignored() {
+    let budget = control_pool(1024, 128);
+    let mut pipe = control_pipe(&budget, false, 65536, 1);
+    let h3 = Connection::with_transport(&mut pipe.server, &Config::new().unwrap()).unwrap();
+    assert!(h3.control_stream_id.is_some());
+    assert!(h3.local_qpack_streams.encoder_stream_id.is_none());
+    assert!(h3.local_qpack_streams.decoder_stream_id.is_none());
+    assert!(pipe.server.local_error().is_none());
+    drop(h3);
+    drop(pipe);
+    assert_eq!(budget.usage(), SendUsage::default());
+}
+
+#[test]
+fn send_propagation_h3_critical_done_keeps_existing_h3_close() {
+    let budget = control_pool(1024, 128);
+    let mut pipe = control_pipe(&budget, false, 0, 8);
+    let result = Connection::with_transport(&mut pipe.server, &Config::new().unwrap());
+    assert!(matches!(result, Err(Error::InternalError)));
+    let error = pipe.server.local_error().unwrap();
+    assert!(error.is_app);
+    assert_eq!(error.error_code, Error::InternalError.to_wire());
+    drop(result);
+    drop(pipe);
+    assert_eq!(budget.usage(), SendUsage::default());
+}
