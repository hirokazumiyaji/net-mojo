+use super::*;
+use crate::{SendBudget, SendLimit, SendLimits, SendUsage};
+use std::mem::size_of;
+
+fn crypto_pool(bytes: usize) -> SendBudget {
+    SendBudget::new(SendLimits {
+        crypto: SendLimit { backing_bytes: bytes, slots: 524288 },
+        ..SendLimits::default()
+    })
+}
+
+fn server_pipe(budget: &SendBudget) -> crate::test_utils::Pipe {
+    let mut config = crate::test_utils::Pipe::default_config("reno").unwrap();
+    config.set_send_budget(budget.clone());
+    crate::test_utils::Pipe::with_server_config(&mut config).unwrap()
+}
+
+fn assert_native_quota_close(conn: &crate::Connection) {
+    let error = conn.local_error().unwrap();
+    assert!(!error.is_app);
+    assert_eq!(error.error_code, Error::SendBufferExceeded.to_wire());
+}
+
+fn assert_wire_quota_close(pipe: &mut crate::test_utils::Pipe) {
+    let mut packet = [0; 1500];
+    let (len, _) = pipe.server.send(&mut packet).unwrap();
+    pipe.client_recv(&mut packet[..len]).unwrap();
+    let error = pipe.client.peer_error().unwrap();
+    assert!(!error.is_app);
+    assert_eq!(error.error_code, Error::SendBufferExceeded.to_wire());
+}
+
+#[test]
+fn send_propagation_tls_initial_reports_exact_quota() {
+    let budget = crypto_pool(0);
+    let mut config = crate::test_utils::Pipe::default_config("reno").unwrap();
+    config.set_send_budget(budget.clone());
+    let mut pipe = crate::test_utils::Pipe::with_client_config(&mut config).unwrap();
+    let mut packet = [0; 1500];
+    let result = pipe.client.send(&mut packet);
+    println!("TLS_INITIAL_QUOTA result={result:?} accepted={} local_error={:?}",
+        pipe.client.crypto_ctx[crate::packet::Epoch::Initial].crypto_stream.send.off_back(),
+        pipe.client.local_error());
+    assert!(matches!(result, Err(Error::SendBufferExceeded)));
+    assert_eq!(budget.usage().crypto.backing_bytes, 0);
+    assert_native_quota_close(&pipe.client);
+    drop(pipe);
+    assert_eq!(budget.usage(), SendUsage::default());
+}
+
+#[test]
+fn send_propagation_tls_handshake_reports_exact_quota() {
+    let unlimited = crypto_pool(usize::MAX);
+    let mut observed = server_pipe(&unlimited);
+    let hello = crate::test_utils::emit_flight(&mut observed.client).unwrap();
+    crate::test_utils::process_flight(&mut observed.server, hello).unwrap();
+    let initial_bytes = observed.server.crypto_ctx[crate::packet::Epoch::Initial]
+        .crypto_stream.send.off_back() as usize;
+    assert!(initial_bytes > 0);
+    assert!(observed.server.crypto_ctx[crate::packet::Epoch::Handshake]
+        .crypto_stream.send.off_back() > 0);
+    drop(observed);
+
+    let budget = crypto_pool(initial_bytes);
+    let mut pipe = server_pipe(&budget);
+    let hello = crate::test_utils::emit_flight(&mut pipe.client).unwrap();
+    let result = crate::test_utils::process_flight(&mut pipe.server, hello);
+    assert_eq!(pipe.server.crypto_ctx[crate::packet::Epoch::Initial]
+        .crypto_stream.send.off_back() as usize, initial_bytes);
+    assert!(pipe.server.crypto_ctx[crate::packet::Epoch::Handshake].crypto_seal.is_some());
+    assert_eq!(pipe.server.crypto_ctx[crate::packet::Epoch::Handshake]
+        .crypto_stream.send.off_back(), 0);
+    println!("TLS_HANDSHAKE_QUOTA initial_bytes={initial_bytes} result={result:?}");
+    assert_eq!(result, Err(Error::SendBufferExceeded));
+    assert_native_quota_close(&pipe.server);
+    assert_wire_quota_close(&mut pipe);
+    drop(pipe);
+    assert_eq!(budget.usage(), SendUsage::default());
+}
+
+#[test]
+fn send_propagation_tls_real_application_ticket_reports_exact_quota() {
+    let budget = crypto_pool(65536);
+    let mut pipe = server_pipe(&budget);
+    let hello = crate::test_utils::emit_flight(&mut pipe.client).unwrap();
+    crate::test_utils::process_flight(&mut pipe.server, hello).unwrap();
+    let flight = crate::test_utils::emit_flight(&mut pipe.server).unwrap();
+    crate::test_utils::process_flight(&mut pipe.client, flight).unwrap();
+    assert!(!pipe.server.is_established());
+    assert!(pipe.client.is_established());
+    assert_eq!(pipe.server.crypto_ctx[crate::packet::Epoch::Application]
+        .crypto_stream.send.off_back(), 0);
+    let free = 65536 - budget.usage().crypto.backing_bytes;
+    let mut occupied = SendBuf::<DefaultBufFactory>::with_budget(
+        u64::MAX, budget.clone(), SendClass::Crypto,
+    ).unwrap();
+    occupied.write(&vec![0; free], false).unwrap();
+    assert_eq!(budget.usage().crypto.backing_bytes, 65536);
+    let finished = crate::test_utils::emit_flight(&mut pipe.client).unwrap();
+    let result = crate::test_utils::process_flight(&mut pipe.server, finished);
+    assert!(pipe.server.crypto_ctx[crate::packet::Epoch::Application].has_keys());
+    assert_eq!(pipe.server.crypto_ctx[crate::packet::Epoch::Application]
+        .crypto_stream.send.off_back(), 0);
+    println!("TLS_APPLICATION_TICKET_QUOTA result={result:?}");
+    assert_eq!(result, Err(Error::SendBufferExceeded));
+    assert_native_quota_close(&pipe.server);
+    assert_wire_quota_close(&mut pipe);
+    drop(occupied);
+    drop(pipe);
+    assert_eq!(budget.usage(), SendUsage::default());
+}
+
+#[test]
+fn send_propagation_marker_free_alpn_failure_remains_tls_failure() {
+    let mut config = crate::test_utils::Pipe::default_config("reno").unwrap();
+    config.set_application_protos(&[b"mismatched"]).unwrap();
+    let mut pipe = crate::test_utils::Pipe::with_client_config(&mut config).unwrap();
+    assert_eq!(pipe.handshake(), Err(Error::TlsFail));
+    assert!(pipe.server.crypto_ctx.iter().all(|space|
+        !space.crypto_stream.send.crypto_send_exhausted));
+    let alert = pipe.server.local_error().unwrap();
+    assert!(!alert.is_app);
+    let error_code = alert.error_code;
+    assert!(error_code >= 0x100);
+    let mut packet = [0; 1500];
+    let (len, _) = pipe.server.send(&mut packet).unwrap();
+    pipe.client_recv(&mut packet[..len]).unwrap();
+    let peer = pipe.client.peer_error().unwrap();
+    assert!(!peer.is_app);
+    assert_eq!(peer.error_code, error_code);
+}
+
+#[test]
+fn send_propagation_exact_callback_marker_clear_and_owner_drop() {
+    for clear_context in [false, true] {
+        let budget = crypto_pool(0);
+        let mut config = crate::test_utils::Pipe::default_config("reno").unwrap();
+        config.set_send_budget(budget.clone());
+        let mut pipe = crate::test_utils::Pipe::with_client_config(&mut config).unwrap();
+        let mut packet = [0; 1500];
+        assert!(matches!(pipe.client.send(&mut packet), Err(Error::SendBufferExceeded)));
+        let context = &mut pipe.client.crypto_ctx[crate::packet::Epoch::Initial];
+        assert!(context.crypto_stream.send.crypto_send_exhausted);
+        if clear_context {
+            context.clear();
+            assert!(!context.crypto_stream.send.crypto_send_exhausted);
+        }
+        assert_eq!(context.crypto_stream.send.off_back(), 0);
+        assert_eq!(budget.usage().crypto.backing_bytes, 0);
+        assert_eq!(budget.usage().crypto.slots, 6);
+        drop(pipe);
+        assert_eq!(budget.usage(), SendUsage::default());
+    }
+    println!("TLS_QUOTA_STATE_LAYOUT SendBuf={} callback_flag={}",
+        size_of::<SendBuf>(), size_of::<bool>());
+}
