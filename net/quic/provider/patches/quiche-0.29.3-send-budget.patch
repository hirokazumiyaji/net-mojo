+#[test]
+fn send_budget_native_ack_retires_real_ticket_backing() {
+    let (mut pipe, budget) = ticket_pipe();
+    let flight = crate::test_utils::emit_flight(&mut pipe.server).unwrap();
+    crate::test_utils::process_flight(&mut pipe.client, flight).unwrap();
+    pipe.client.send_ack_eliciting().unwrap();
+    let ack = crate::test_utils::emit_flight(&mut pipe.client).unwrap();
+    let before = budget.usage().crypto.backing_bytes;
+    assert!(before > 0);
+    crate::test_utils::process_flight(&mut pipe.server, ack).unwrap();
+    assert!(budget.usage().crypto.backing_bytes < before);
+}
