+#[derive(Clone, Debug)]
+struct SplitBytes(bytes::Bytes);
+thread_local! { static SPLITS: Cell<usize> = const { Cell::new(0) }; }
+impl AsRef<[u8]> for SplitBytes {
+    fn as_ref(&self) -> &[u8] {
+        &self.0
+    }
+}
+impl BufSplit for SplitBytes {
+    fn split_at(&mut self, at: usize) -> Self {
+        SPLITS.with(|n| n.set(n.get() + 1));
+        Self(self.0.split_off(at))
+    }
+}
+#[derive(Clone, Debug, Default)]
+struct BytesFactory;
+impl BufFactory for BytesFactory {
+    type Buf = SplitBytes;
+    type DgramBuf = Vec<u8>;
+    fn buf_from_slice(bytes: &[u8]) -> SplitBytes {
+        SplitBytes(bytes::Bytes::copy_from_slice(bytes))
+    }
+    fn dgram_buf_from_slice(bytes: &[u8]) -> Vec<u8> {
+        bytes.into()
+    }
+}
+
+#[test]
+fn send_budget_zero_copy_split_admits_only_accepted_view_and_returns_remainder() {
+    SPLITS.with(|n| n.set(0));
+    let budget = budget(3, 6);
+    let mut send =
+        SendBuf::<BytesFactory>::with_budget(100, budget.clone(), SendClass::Request).unwrap();
+    let input = SplitBytes(bytes::Bytes::copy_from_slice(b"abcde"));
+    let pointer = input.as_ref().as_ptr();
+    let (accepted, remainder) = send.append_buf(input, 3, false).unwrap();
+    assert_eq!(accepted, 3);
+    assert_eq!(remainder.unwrap().as_ref(), b"de");
+    assert_eq!(send.data.front().unwrap().data.as_ref().as_ptr(), pointer);
+    assert_eq!(SPLITS.with(Cell::get), 1);
+    assert_eq!(send.data.capacity(), 4);
+    request_usage(&budget, 3, 6);
+    assert!(matches!(
+        send.append_buf(SplitBytes(bytes::Bytes::copy_from_slice(b"fg")), 1, true),
+        Err(Error::SendBufferExceeded)
+    ));
+    assert_eq!(SPLITS.with(Cell::get), 1);
+    assert_eq!(
+        (send.off_back(), send.fin_off, send.data.capacity()),
+        (3, None, 4)
+    );
+    request_usage(&budget, 3, 6);
+    let mut body = [0; 3];
+    assert_eq!(send.emit(&mut body), Ok((3, false)));
+    assert_eq!(&body, b"abc");
+    drop(send);
+    assert_eq!(budget.usage(), SendUsage::default());
+}
