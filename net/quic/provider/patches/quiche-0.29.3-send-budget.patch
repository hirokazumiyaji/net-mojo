+#[test]
+fn send_budget_closing_lost_crypto_still_emits_connection_close_at_full_quota() {
+    use crate::recovery::RecoveryOps;
+    let (mut pipe, budget) = ticket_pipe();
+    let _lost = partial_ticket(&mut pipe);
+    crate::test_utils::trigger_ack_based_loss(&mut pipe.server, &mut pipe.client);
+    assert!(pipe
+        .server
+        .paths
+        .get_active()
+        .unwrap()
+        .recovery
+        .has_lost_frames(crate::packet::Epoch::Application));
+    let free = 65536 - budget.usage().crypto.backing_bytes;
+    let mut occupied =
+        SendBuf::<DefaultBufFactory>::with_budget(u64::MAX, budget.clone(), SendClass::Crypto)
+            .unwrap();
+    occupied.write(&vec![0; free], false).unwrap();
+    assert_eq!(budget.usage().crypto.backing_bytes, 65536);
+    assert_eq!(pipe.server.close(false, 1, b"quota"), Ok(()));
+    let mut packet = [0; 1500];
+    let (len, _) = pipe
+        .server
+        .send(&mut packet)
+        .expect("closing must skip lost CRYPTO allocation");
+    let frames = crate::test_utils::decode_pkt(&mut pipe.client, &mut packet[..len]).unwrap();
+    assert!(frames.iter().any(|f| matches!(
+        f,
+        crate::frame::Frame::ConnectionClose { error_code: 1, .. }
+    )));
+    assert!(!frames
+        .iter()
+        .any(|f| matches!(f, crate::frame::Frame::Crypto { .. })));
+}
