+fn ticket_pipe() -> (crate::test_utils::Pipe, SendBudget) {
+    let budget = SendBudget::new(SendLimits {
+        crypto: SendLimit {
+            backing_bytes: 65536,
+            slots: 524288,
+        },
+        ..SendLimits::default()
+    });
+    let mut config = crate::test_utils::Pipe::default_config("reno").unwrap();
+    config.set_send_budget(budget.clone());
+    let mut pipe = crate::test_utils::Pipe::with_server_config(&mut config).unwrap();
+    let flight = crate::test_utils::emit_flight(&mut pipe.client).unwrap();
+    crate::test_utils::process_flight(&mut pipe.server, flight).unwrap();
+    let flight = crate::test_utils::emit_flight(&mut pipe.server).unwrap();
+    crate::test_utils::process_flight(&mut pipe.client, flight).unwrap();
+    let flight = crate::test_utils::emit_flight(&mut pipe.client).unwrap();
+    crate::test_utils::process_flight(&mut pipe.server, flight).unwrap();
+    assert!(pipe.server.is_established());
+    assert!(pipe.client.is_established());
+    assert!(
+        pipe.server.crypto_ctx[crate::packet::Epoch::Application]
+            .crypto_stream
+            .send
+            .buffered_bytes()
+            > 0
+    );
+    (pipe, budget)
+}
+
+fn partial_ticket(pipe: &mut crate::test_utils::Pipe) -> (Vec<u8>, crate::SendInfo) {
+    for size in 55..80 {
+        let mut packet = vec![0; size];
+        let (len, info) = pipe.server.send(&mut packet).unwrap();
+        packet.truncate(len);
+        let frames = crate::test_utils::decode_pkt(&mut pipe.client, &mut packet.clone()).unwrap();
+        for frame in frames {
+            if let crate::frame::Frame::Crypto { data } = frame {
+                let end = data.max_off();
+                if pipe.server.crypto_ctx[crate::packet::Epoch::Application]
+                    .crypto_stream
+                    .send
+                    .data
+                    .iter()
+                    .any(|buf| buf.off < end && end < buf.max_off())
+                {
+                    return (packet, info);
+                }
+            }
+        }
+    }
+    panic!("no partial native TLS ticket frame");
+}
