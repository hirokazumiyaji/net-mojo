+fn send_budget_closing_lost_stream_still_emits_connection_close_at_full_quota() {
+    use crate::recovery::RecoveryOps;
+    let budget = SendBudget::new(SendLimits {
+        request: SendLimit {
+            backing_bytes: 15,
+            slots: 16,
+        },
+        ..SendLimits::default()
+    });
+    let mut config = crate::test_utils::Pipe::default_config("reno").unwrap();
+    config.set_send_budget(budget.clone());
+    let mut pipe = crate::test_utils::Pipe::with_server_config(&mut config).unwrap();
+    pipe.handshake().unwrap();
+    pipe.advance().unwrap();
+    pipe.server
+        .stream_send(1, b"abcdefghijklmno", true)
+        .unwrap();
+    let mut lost = [0; 47];
+    let (len, _) = pipe.server.send(&mut lost).unwrap();
+    let frames = crate::test_utils::decode_pkt(&mut pipe.client, &mut lost[..len]).unwrap();
+    assert!(frames.iter().any(|f| {
+        if let crate::frame::Frame::Stream { data, .. } = f {
+            let end = data.max_off();
+            data.len() > 0
+                && data.len() < 15
+                && pipe
+                    .server
+                    .streams
+                    .get_mut(1)
+                    .unwrap()
+                    .send
+                    .data
+                    .iter()
+                    .any(|buf| buf.off < end && end < buf.max_off())
+        } else {
+            false
+        }
+    }));
+    crate::test_utils::trigger_ack_based_loss(&mut pipe.server, &mut pipe.client);
+    assert!(pipe
+        .server
+        .paths
+        .get_active()
+        .unwrap()
+        .recovery
+        .has_lost_frames(crate::packet::Epoch::Application));
+    assert_eq!(budget.usage().request.backing_bytes, 15);
+    pipe.server.close(false, 1, b"quota").unwrap();
+    let mut packet = [0; 1500];
+    let (len, _) = pipe
+        .server
+        .send(&mut packet)
+        .expect("closing must skip lost STREAM allocation");
+    let frames = crate::test_utils::decode_pkt(&mut pipe.client, &mut packet[..len]).unwrap();
+    assert!(frames.iter().any(|f| matches!(
+        f,
+        crate::frame::Frame::ConnectionClose { error_code: 1, .. }
+    )));
+    assert!(!frames
+        .iter()
+        .any(|f| matches!(f, crate::frame::Frame::Stream { .. })));
+}
