+use crate::receive_budget::{BufferCharge, ReceiveClass, Reservation};
+use crate::{Error, ReceiveBudget, ReceiveLimit, ReceiveLimits, Result};
+
+pub(crate) use crate::receive_budget::ReceiveClass as SendClass;
+
+/// Independent retained backing and allocated send-buffer population limits.
+#[derive(Clone, Copy, Debug, Default, PartialEq, Eq)]
+pub struct SendLimit {
+    /// Full backing bytes conservatively charged per retained view.
+    pub backing_bytes: usize,
+    /// Owner tokens and actual allocated deque cells, not allocator bytes.
+    pub slots: usize,
+}
+
+/// Separate send resources for bidirectional, unidirectional and CRYPTO data.
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub struct SendLimits {
+    /// Bidirectional send resources.
+    pub request: SendLimit,
+    /// Unidirectional send resources.
+    pub control: SendLimit,
+    /// CRYPTO send resources across all packet epochs.
+    pub crypto: SendLimit,
+}
+
+impl Default for SendLimits {
+    fn default() -> Self {
+        let unlimited = SendLimit {
+            backing_bytes: usize::MAX,
+            slots: usize::MAX,
+        };
+        Self {
+            request: unlimited,
+            control: unlimited,
+            crypto: unlimited,
+        }
+    }
+}
+
+/// Conservative committed and in-progress send reservations.
+#[derive(Clone, Copy, Debug, Default, PartialEq, Eq)]
+pub struct SendUsage {
+    /// Bidirectional send resources.
+    pub request: SendLimit,
+    /// Unidirectional send resources.
+    pub control: SendLimit,
+    /// CRYPTO send resources across all packet epochs.
+    pub crypto: SendLimit,
+}
+
+/// Immutable send capacities shared by configurations and connections.
+#[derive(Clone, Debug, Default)]
+pub struct SendBudget(ReceiveBudget);
+
+impl SendBudget {
+    /// Creates a send pool independent from all receive pools.
+    pub fn new(limits: SendLimits) -> Self {
+        Self(ReceiveBudget::new(ReceiveLimits {
+            request: limits.request.into(),
+            control: limits.control.into(),
+            crypto: limits.crypto.into(),
+        }))
+    }
+    /// Returns a consistent snapshot including in-progress admissions.
+    pub fn usage(&self) -> SendUsage {
+        let used = self.0.usage();
+        SendUsage {
+            request: used.request.into(),
+            control: used.control.into(),
+            crypto: used.crypto.into(),
+        }
+    }
+}
+
+impl From<SendLimit> for ReceiveLimit {
+    fn from(limit: SendLimit) -> Self {
+        Self {
+            backing_bytes: limit.backing_bytes,
+            slots: limit.slots,
+        }
+    }
+}
+
+impl From<ReceiveLimit> for SendLimit {
+    fn from(limit: ReceiveLimit) -> Self {
+        Self {
+            backing_bytes: limit.backing_bytes,
+            slots: limit.slots,
+        }
+    }
+}
+
+#[derive(Debug)]
+pub(crate) struct SendCharge(pub(crate) BufferCharge);
+
+impl SendCharge {
+    pub(crate) fn new(budget: SendBudget, class: ReceiveClass) -> Result<Self> {
+        BufferCharge::new(budget.0, class)
+            .map(Self)
+            .map_err(|_| Error::SendBufferExceeded)
+    }
+    pub(crate) fn reserve(&self, backing_bytes: usize, slots: usize) -> Result<Reservation> {
+        self.0
+            .reserve(ReceiveLimit {
+                backing_bytes,
+                slots,
+            })
+            .map_err(|_| Error::SendBufferExceeded)
+    }
+    pub(crate) fn release(&mut self, backing_bytes: usize, slots: usize) {
+        self.0.release_amount(ReceiveLimit {
+            backing_bytes,
+            slots,
+        });
+    }
+    pub(crate) fn clear_retained(&mut self) {
+        self.0.clear_retained();
+    }
+}
