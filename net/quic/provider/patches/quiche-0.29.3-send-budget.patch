+use super::*;
+use crate::receive_budget::ReceiveClass;
+use crate::send_budget::{SendBudget, SendClass, SendLimit, SendLimits, SendUsage};
+use std::cell::{Cell, RefCell};
+use std::mem::size_of;
+use std::sync::Arc;
+
+fn budget(bytes: usize, slots: usize) -> SendBudget {
+    SendBudget::new(SendLimits {
+        request: SendLimit {
+            backing_bytes: bytes,
+            slots,
+        },
+        control: SendLimit {
+            backing_bytes: 32,
+            slots: 10,
+        },
+        crypto: SendLimit {
+            backing_bytes: 32,
+            slots: 20,
+        },
+    })
+}
+
+fn buffer(budget: &SendBudget) -> SendBuf {
+    SendBuf::with_budget(u64::MAX, budget.clone(), SendClass::Request).unwrap()
+}
+
+fn snapshot(
+    send: &SendBuf,
+) -> (
+    usize,
+    u64,
+    u64,
+    u64,
+    Option<u64>,
+    Vec<(usize, usize, usize, usize, usize, u64, bool)>,
+) {
+    (
+        send.pos,
+        send.off,
+        send.emit_off,
+        send.buffered_bytes,
+        send.fin_off,
+        send.data
+            .iter()
+            .map(|b| {
+                (
+                    b as *const _ as usize,
+                    b.data.as_ref().as_ptr() as usize,
+                    b.start,
+                    b.pos,
+                    b.len,
+                    b.off,
+                    b.fin,
+                )
+            })
+            .collect(),
+    )
+}
+
+fn request_usage(budget: &SendBudget, bytes: usize, slots: usize) {
+    assert_eq!(
+        budget.usage().request,
+        SendLimit {
+            backing_bytes: bytes,
+            slots
+        }
+    );
+}
+
+thread_local! {
+    static COPIES: Cell<usize> = const { Cell::new(0) };
+    static FACTORY_BUDGET: RefCell<Option<SendBudget>> = const { RefCell::new(None) };
+    static DESTROYED_AT: RefCell<Vec<SendLimit>> = const { RefCell::new(Vec::new()) };
+}
+
+#[derive(Debug)]
+struct Backing {
+    bytes: Box<[u8]>,
+    budget: SendBudget,
+}
+
+impl Drop for Backing {
+    fn drop(&mut self) {
+        DESTROYED_AT.with(|seen| seen.borrow_mut().push(self.budget.usage().request));
+    }
+}
+
+#[derive(Clone, Debug)]
+struct TrackedBuf(Arc<Backing>);
+
+impl AsRef<[u8]> for TrackedBuf {
+    fn as_ref(&self) -> &[u8] {
+        &self.0.bytes
+    }
+}
+
+#[derive(Clone, Debug, Default)]
+struct TrackedFactory;
+
+impl BufFactory for TrackedFactory {
+    type Buf = TrackedBuf;
+    type DgramBuf = Vec<u8>;
+    fn buf_from_slice(bytes: &[u8]) -> TrackedBuf {
+        COPIES.with(|count| count.set(count.get() + 1));
+        let budget = FACTORY_BUDGET.with(|b| b.borrow().as_ref().unwrap().clone());
+        TrackedBuf(Arc::new(Backing {
+            bytes: bytes.into(),
+            budget,
+        }))
+    }
+    fn dgram_buf_from_slice(bytes: &[u8]) -> Vec<u8> {
+        bytes.into()
+    }
+}
+
+fn tracked(budget: &SendBudget) -> SendBuf<TrackedFactory> {
+    COPIES.with(|count| count.set(0));
+    DESTROYED_AT.with(|seen| seen.borrow_mut().clear());
+    FACTORY_BUDGET.with(|b| *b.borrow_mut() = Some(budget.clone()));
+    SendBuf::with_budget(u64::MAX, budget.clone(), SendClass::Request).unwrap()
+}
